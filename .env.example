# ===================================================================
# CareerBridge Environment Configuration Template
# Copy this file to .env or export these variables in your deployment environment.
# ===================================================================

# Server Configuration
SERVER_PORT=8080

# Database Configuration (H2 File-based or PostgreSQL/MySQL)
# Default is embedded file H2 database
SPRING_DATASOURCE_URL=jdbc:h2:file:./careerbridge_db;DB_CLOSE_DELAY=-1;AUTO_SERVER=TRUE
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# H2 Web Console (/h2-console)
H2_CONSOLE_ENABLED=true

# Security & JWT Configuration
# Generate a 256-bit secret key in base64/hex for production environments
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# File Storage Configuration (Resume Uploads)
FILE_UPLOAD_DIR=uploads
